{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/say", "destination": "/api/say" },
    { "source": "/health", "destination": "/api/health" }
  ],
  "functions": {
    "api/say.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/素材/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
